<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Andromeda</title>
  <style>
    body {
      margin: 0;
      padding: 0;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background-color: #000;
      color: white;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
      text-align: center;
      background-image: url('bg.jpg');
      background-size: cover;
      background-position: center;
    }

    .logo img {
      width: 160px;
      height: auto;
      margin-bottom: 20px;
    }

    h1 {
      font-size: 2.5em;
      margin: 0;
    }

    p {
      font-size: 1.2em;
      margin-top: 10px;
      max-width: 600px;
    }

    .footer {
      position: absolute;
      bottom: 15px;
      font-size: 0.9em;
      color: #aaa;
    }
  </style>
</head>
<body>

  <div class="logo">
    <img src="Каталог/лого.png" alt="Andromeda Logo">
  </div>

  <h1>ANDROMEDA</h1>
  <p>The future is in your hands.</p>

  <div class="footer">
    Contact: andromedatoken01@gmail.com<br>
    © 2025 Andromeda Project. All rights reserved.
  </div>

</body>
</html>
